{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipit",
  "version": "0.13.3",
  "identifier": "com.clipit.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clipit",
        "width": 1320,
        "height": 820,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "MoathByte",
    "copyright": "Copyright (c) 2026 MoathByte. MIT License.",
    "shortDescription": "Lightweight game clipper and clip library"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQzRDOTg0QkMzQUI3REEKUldUYXR6cThoTW5FVXlyb0VhUkJHQ2l6K1FsRE5aY1JnVHpvaFZXa1JFSEJtL1ZEN0V1T0ZiTUUK",
      "endpoints": [
        "https://github.com/MoathByte/clipit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}